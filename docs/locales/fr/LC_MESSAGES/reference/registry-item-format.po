msgid "Checked when files are written by `kikx add`, `kikx setup` and `kikx apply`. `POST /api/render` does not write and applies only the duplicate check within one item."
msgstr "Vérifiées lorsque les fichiers sont écrits par `kikx add`, `kikx setup` et `kikx apply`. `POST /api/render` n'écrit rien et n'applique que la vérification des doublons au sein d'un même élément."

msgid "Rule"
msgstr "Règle"

msgid "Error"
msgstr "Erreur"

msgid "Two files of one item render to the same path"
msgstr "Deux fichiers d'un même élément sont rendus vers le même chemin"

msgid "`` <category>/<name> has two files that both render to `<path>` ``"
msgstr "`` <category>/<name> has two files that both render to `<path>` ``"

msgid "Two files of one run render to the same path (`setup`, `apply`)"
msgstr "Deux fichiers d'une même exécution sont rendus vers le même chemin (`setup`, `apply`)"

msgid "`` two files rendered to the same path: `<path>` ``"
msgstr "`` two files rendered to the same path: `<path>` ``"

msgid "Path is absolute"
msgstr "Le chemin est absolu"

msgid "`` refusing to write `<path>` — absolute paths are not allowed ``"
msgstr "`` refusing to write `<path>` — absolute paths are not allowed ``"

msgid "Path, read left to right, climbs above the target directory at any `..`"
msgstr "Le chemin, lu de gauche à droite, remonte au-dessus du répertoire cible à un `..` quelconque"

msgid "`` refusing to write `<path>` — it escapes the target directory ``"
msgstr "`` refusing to write `<path>` — it escapes the target directory ``"

