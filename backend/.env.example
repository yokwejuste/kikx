# kikx-backend configuration. Copy to `.env` (git-ignored) and adjust.
# Every value can also be passed as a flag (see `cargo run -- --help`);
# flags and real environment variables take precedence over this file.

# Port the API listens on.
KIKX_PORT=4000

# Address to bind. Keep it on loopback unless the API must be reachable from other machines.
KIKX_BIND=127.0.0.1

# Comma-separated browser origins allowed to call the API.
# Leave empty to allow any loopback origin (localhost / 127.0.0.1 / [::1]) on any port.
KIKX_ALLOWED_ORIGINS=
