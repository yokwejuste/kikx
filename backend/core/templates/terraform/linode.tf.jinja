terraform {
  required_providers {
    linode = {
      source = "linode/linode"
    }
  }
}

variable "linode_token" {
  description = "Linode API token. Set via TF_VAR_linode_token or a gitignored terraform.tfvars."
  type        = string
  sensitive   = true
}

variable "ssh_public_key" {
  description = "Public SSH key allowed to log in as root."
  type        = string
}

provider "linode" {
  token = var.linode_token
}
{%- if private_network %}

resource "linode_vpc" "{{ name }}" {
  label  = "{{ name }}-network"
  region = "{{ region }}"
}

resource "linode_vpc_subnet" "{{ name }}" {
  vpc_id = linode_vpc.{{ name }}.id
  label  = "{{ name }}-subnet"
  ipv4   = "{{ private_network }}"
}
{%- endif %}

resource "linode_instance" "{{ name }}" {
  count           = {{ count }}
  label           = "{{ name }}-${count.index}"
  region          = "{{ region }}"
  type            = "{{ size }}"
  image           = "{{ os_image }}"
  authorized_keys = [var.ssh_public_key]
{%- if private_network %}

  interface {
    purpose = "public"
  }

  interface {
    purpose   = "vpc"
    subnet_id = linode_vpc_subnet.{{ name }}.id
  }
{%- endif %}
}
