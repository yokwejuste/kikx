variable "do_token" {
  description = "DigitalOcean API token. Set via TF_VAR_do_token or a gitignored terraform.tfvars."
  type        = string
  sensitive   = true
}

provider "digitalocean" {
  token = var.do_token
}
{%- if private_network %}

resource "digitalocean_vpc" "{{ name }}" {
  name     = "{{ name }}-network"
  region   = "{{ region }}"
  ip_range = "{{ private_network }}"
}
{%- endif %}

resource "digitalocean_droplet" "{{ name }}" {
  count  = {{ count }}
  name   = "{{ name }}-${count.index}"
  region = "{{ region }}"
  size   = "{{ size }}"
  image  = "{{ os_image }}"
{%- if private_network %}

  vpc_uuid = digitalocean_vpc.{{ name }}.id
{%- endif %}
}
