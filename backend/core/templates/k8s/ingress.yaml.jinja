apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
spec:
  rules:
    - host: {{ host | default(name ~ ".example.com") }}
      http:
        paths:
          - path: {{ path }}
            pathType: Prefix
            backend:
              service:
                name: {{ service | default(name) }}
                port:
                  number: {{ port }}
