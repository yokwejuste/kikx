{
  "name": "multi-tier-platform",
  "title": "Multi-tier platform",
  "description": "A storefront platform: edge load balancers, web/app tiers, PostgreSQL primary + replicas, Redis, monitoring and a Kubernetes cluster.",
  "project": {
    "name": "multi-tier-platform",
    "namespace": "shop",
    "outputDir": "infra"
  },
  "components": [
    {
      "reference": "terraform/hetzner",
      "name": "edge",
      "fields": {
        "region": "fsn1",
        "size": "cx22",
        "os_image": "ubuntu-24.04",
        "count": "2"
      },
      "labels": {}
    },
    {
      "reference": "ansible/inventory",
      "name": "platform",
      "fields": {
        "hosts": "[{\"group\": \"lb\", \"members\": [{\"name\": \"lb-01\", \"ansible_host\": \"192.0.2.11\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"lb-02\", \"ansible_host\": \"192.0.2.12\", \"ansible_user\": null, \"ansible_port\": null}]}, {\"group\": \"web\", \"members\": [{\"name\": \"web-01\", \"ansible_host\": \"192.0.2.21\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"web-02\", \"ansible_host\": \"192.0.2.22\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"web-03\", \"ansible_host\": \"192.0.2.23\", \"ansible_user\": null, \"ansible_port\": null}]}, {\"group\": \"app\", \"members\": [{\"name\": \"app-01\", \"ansible_host\": \"192.0.2.31\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"app-02\", \"ansible_host\": \"192.0.2.32\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"app-03\", \"ansible_host\": \"192.0.2.33\", \"ansible_user\": null, \"ansible_port\": null}]}, {\"group\": \"db_primary\", \"members\": [{\"name\": \"db-01\", \"ansible_host\": \"198.51.100.11\", \"ansible_user\": null, \"ansible_port\": null, \"vars\": {\"postgres_role\": \"primary\"}}]}, {\"group\": \"db_replicas\", \"members\": [{\"name\": \"db-02\", \"ansible_host\": \"198.51.100.12\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"db-03\", \"ansible_host\": \"198.51.100.13\", \"ansible_user\": null, \"ansible_port\": null}]}, {\"group\": \"cache\", \"members\": [{\"name\": \"cache-01\", \"ansible_host\": \"198.51.100.21\", \"ansible_user\": null, \"ansible_port\": null}]}, {\"group\": \"monitoring\", \"members\": [{\"name\": \"mon-01\", \"ansible_host\": \"198.51.100.31\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"cache-01\", \"ansible_host\": null, \"ansible_user\": null, \"ansible_port\": null}]}, {\"group\": \"k8s_control_plane\", \"members\": [{\"name\": \"cp-01\", \"ansible_host\": \"203.0.113.11\", \"ansible_user\": null, \"ansible_port\": null, \"vars\": {\"kube_bootstrap\": \"true\"}}, {\"name\": \"cp-02\", \"ansible_host\": \"203.0.113.12\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"cp-03\", \"ansible_host\": \"203.0.113.13\", \"ansible_user\": null, \"ansible_port\": null}]}, {\"group\": \"k8s_workers\", \"members\": [{\"name\": \"worker-01\", \"ansible_host\": \"203.0.113.21\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"worker-02\", \"ansible_host\": \"203.0.113.22\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"worker-03\", \"ansible_host\": \"203.0.113.23\", \"ansible_user\": null, \"ansible_port\": null}, {\"name\": \"worker-04\", \"ansible_host\": \"203.0.113.24\", \"ansible_user\": null, \"ansible_port\": null}]}, {\"group\": \"frontend\", \"children\": [\"lb\", \"web\"]}, {\"group\": \"db\", \"children\": [\"db_primary\", \"db_replicas\"]}, {\"group\": \"k8s\", \"children\": [\"k8s_control_plane\", \"k8s_workers\"]}, {\"group\": \"platform\", \"children\": [\"frontend\", \"app\", \"db\", \"cache\", \"monitoring\", \"k8s\"], \"vars\": {\"ansible_user\": \"deploy\", \"ansible_python_interpreter\": \"/usr/bin/python3\"}}]"
      },
      "labels": {}
    },
    {
      "reference": "ansible/config",
      "name": "ansible",
      "fields": {
        "inventory": "platform-inventory.ini"
      },
      "labels": {}
    },
    {
      "reference": "ansible/group-vars",
      "name": "all/main",
      "fields": {
        "group": "all",
        "layout": "dir",
        "yaml": "timezone: UTC\nntp_servers:\n  - 0.pool.ntp.org\n  - 1.pool.ntp.org\n"
      },
      "labels": {}
    },
    {
      "reference": "ansible/group-vars",
      "name": "web",
      "fields": {
        "group": "web",
        "vars": "{\"nginx_worker_processes\": \"auto\", \"nginx_client_max_body_size\": \"25m\"}"
      },
      "labels": {}
    },
    {
      "reference": "ansible/group-vars",
      "name": "db",
      "fields": {
        "group": "db",
        "yaml": "postgres_version: 16\npostgres_max_connections: 300\nbackup:\n  schedule: \"0 2 * * *\"\n  retention_days: 14\n"
      },
      "labels": {}
    },
    {
      "reference": "ansible/group-vars",
      "name": "k8s",
      "fields": {
        "group": "k8s",
        "vars": "{\"kube_version\": \"1.31\", \"pod_network_cidr\": \"10.244.0.0/16\"}"
      },
      "labels": {}
    },
    {
      "reference": "ansible/playbook",
      "name": "bootstrap",
      "fields": {
        "plays": "[{\"name\": \"Baseline every host\", \"hosts\": \"platform\", \"become\": true, \"tags\": [\"bootstrap\"], \"roles\": [\"common\"], \"pre_tasks\": \"- name: Wait for SSH\\n  ansible.builtin.wait_for_connection:\\n    timeout: 300\\n\"}]",
        "folder": "playbooks"
      },
      "labels": {}
    },
    {
      "reference": "ansible/playbook",
      "name": "edge",
      "fields": {
        "plays": "[{\"name\": \"Load balancers\", \"hosts\": \"lb\", \"become\": true, \"tags\": [\"edge\"], \"roles\": [\"haproxy\"]}, {\"name\": \"Web servers\", \"hosts\": \"web\", \"become\": true, \"tags\": [\"edge\"], \"roles\": [\"nginx\"]}]",
        "folder": "playbooks"
      },
      "labels": {}
    },
    {
      "reference": "ansible/playbook",
      "name": "app",
      "fields": {
        "plays": "[{\"name\": \"Application servers\", \"hosts\": \"app\", \"become\": true, \"tags\": [\"app\"], \"roles\": [\"app_runtime\"]}]",
        "folder": "playbooks"
      },
      "labels": {}
    },
    {
      "reference": "ansible/playbook",
      "name": "data",
      "fields": {
        "plays": "[{\"name\": \"PostgreSQL\", \"hosts\": \"db\", \"become\": true, \"tags\": [\"db\"], \"roles\": [\"postgres\", {\"role\": \"pg_replication\", \"when\": \"groups['db_replicas'] | length > 0\"}]}, {\"name\": \"Redis cache\", \"hosts\": \"cache\", \"become\": true, \"tags\": [\"cache\"], \"roles\": [\"redis\"]}]",
        "folder": "playbooks"
      },
      "labels": {}
    },
    {
      "reference": "ansible/playbook",
      "name": "k8s",
      "fields": {
        "plays": "[{\"name\": \"Container runtime\", \"hosts\": \"k8s\", \"become\": true, \"tags\": [\"k8s\"], \"roles\": [\"containerd\", \"kubeadm\"]}, {\"name\": \"Control plane\", \"hosts\": \"k8s_control_plane\", \"become\": true, \"tags\": [\"k8s\"], \"roles\": [\"kube_control_plane\", \"calico\"]}, {\"name\": \"Workers\", \"hosts\": \"k8s_workers\", \"become\": true, \"tags\": [\"k8s\"], \"roles\": [\"kube_worker\"]}]",
        "folder": "playbooks"
      },
      "labels": {}
    },
    {
      "reference": "ansible/playbook",
      "name": "monitoring",
      "fields": {
        "plays": "[{\"name\": \"Observability\", \"hosts\": \"monitoring\", \"become\": true, \"tags\": [\"monitoring\"], \"roles\": [\"prometheus\", \"grafana\"]}]",
        "folder": "playbooks"
      },
      "labels": {}
    },
    {
      "reference": "ansible/site",
      "name": "site",
      "labels": {},
      "fields": {
        "playbooks": "[{\"name\": \"Baseline\", \"path\": \"playbooks/bootstrap.yml\"}, {\"name\": \"Edge tier\", \"path\": \"playbooks/edge.yml\"}, {\"name\": \"Application tier\", \"path\": \"playbooks/app.yml\"}, {\"name\": \"Data tier\", \"path\": \"playbooks/data.yml\"}, {\"name\": \"Kubernetes\", \"path\": \"playbooks/k8s.yml\"}, {\"name\": \"Observability\", \"path\": \"playbooks/monitoring.yml\"}]"
      }
